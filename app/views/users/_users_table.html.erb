<%= form_with url: users_path, method: :patch do %>
  <div>
    <div class="digg_pagination mb-1">
      <%= will_paginate @users, :container => false %>
    </div>

    <div class='bg-body-tertiary p-2 d-flex flex-wrap gap-2'>
      <span class='relative group'>
        <button type="submit" class="btn btn-sm btn-warning"
                formaction="<%= users_path %>" tabindex="0"
                data-bs-toggle="popover" data-bs-trigger="hover focus"
                data-bs-content="Block selected users">
          🔐 Block
        </button>
      </span>

      <span class='relative group'>
        <button type="submit" class="btn btn-sm btn-success"
                formaction="<%= users_path %>" tabindex="0"
                data-bs-toggle="popover" data-bs-trigger="hover focus"
                data-bs-content="Unblock selected users">
          🔓
        </button>
      </span>

      <span class='relative group'>
        <button type="submit" class="btn btn-sm btn-danger"
                formaction="<%= users_path %>" tabindex="0"
                name="_method" value="delete"
                data-bs-toggle="popover" data-bs-trigger="hover focus"
                data-bs-content="Delete selected users">
          🗑️
        </button>
      </span>
    </div>

    <div class='table-responsive'>
      <table class="table table-hover" data-controller="checkbox-select-all"
             data-checkbox-select-all-toggle-key-value="x">
        <thead>
          <tr>
            <th>
              <%# <input
                type="checkbox"
                class="form-check-input"
                id='select-all-tasks'
                autocomplete='off',
                name='user_ids[]',
                value='all_users'
                /> %>
            </th>
            <th>Email</th>
            <th>Admin</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each.with_index do |user, i| %>
            <tr>
              <td>
                <input
                  type="checkbox"
                  class="form-check-input"
                  name='user_ids[]'
                  autocomplete='off',
                  value='<%= user.id %>'
                  data-checkbox-select-all-target="checkbox"
                  data-action="click->checkbox-select-all#toggle" />
              </td>
              <td><%= user.email %></td>
              <td><%= user.admin %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
