<%= form_with url: users_path, method: :patch do %>
  <div>
    <div class="digg_pagination mb-1">
      <%= will_paginate @users, :container => false %>
    </div>

    <%= render 'users/users_toolbar' %>

    <div class='table-responsive'>
      <table class="table table-hover" data-controller="checkbox-select-all"
             data-checkbox-select-all-toggle-key-value="x">
        <thead>
          <tr>
            <th>
              <input
                type="checkbox"
                class="form-check-input"
                id='select-all-users'
                autocomplete='off'
                data-checkbox-select-all-target="selectAll"
                data-action="click->checkbox-select-all#toggleAll"
                />
            </th>
            <th>Email</th>
            <th>Admin</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <input
                  type="checkbox"
                  class="form-check-input"
                  name='user_ids[]'
                  autocomplete='off'
                  value='<%= user.id %>'
                  data-checkbox-select-all-target="checkbox"
                  data-action="click->checkbox-select-all#toggle"
                />
              </td>
              <td><%= user.email %></td>
              <td><%= user.admin %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
