<div class="container-fluid d-flex p-0">
  <div class="col-12 col-sm-6 d-flex align-items-center justify-content-center">
    <div class="w-100 px-3" style="max-width: 24rem;">
      <h2 class='pb-3'>Create new Category</h2>
      <%= form_with model: @category, class: 'd-flex flex-column gap-3' do |f| %>
        <%= render "devise/shared/error_messages", resource: @category %>

        <div>
          <%= f.label :title, class: 'form-label' %>
          <%= f.text_field :title, class: 'form-control', autofocus: true, required: true %>
        </div>
        
        <%= f.submit "Sign up", class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
</div>
