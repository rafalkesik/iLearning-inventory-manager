<!DOCTYPE html>
<html data-bs-theme="light">
  <head>
    <title>Inventory2000</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= favicon_link_tag 'favicon.png' %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class='h-100 min-vh-100 d-flex flex-column bg-body-tertiary'>
    <nav>
      <%= render 'layouts/navbar' %>
    </nav>

    <main class='container py-5 my-3 px-3 d-flex flex-column h-100 min-vh-85 bg-body'>
      <%= yield %>
    </main>
  </body>
</html>
