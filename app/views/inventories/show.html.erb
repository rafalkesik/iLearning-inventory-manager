<div class='d-flex flex-column gap-5'>
  <h1>
    Inventory view
  </h1>

  <div class='d-flex flex-column gap-3 px-3'>
    <%= link_to "←Back to the list", inventories_path,
                class: 'btn btn-outline-secondary align-self-start' %>

    <div class="card">
      <div class="card-header">
        <span class='badge text-bg-info'><%= @inventory.category&.title %></span>
        <span class='badge text-bg-warning'>Example_tag</span>
      </div>
      <div class="card-body">
        <div class='row'>
          <div class='col-8'>
            <h5 class="card-title"><%= @inventory.title %></h5>
            <p class="card-text"><%= @inventory.description %></p>
          </div>
          
          <p class='col-4 fw-lighter fw-italic text-end'>
            Author: <%= @inventory.author.email %>
          </p>
        </div>
      </div>
    </div>
    
    <%= render 'inventories/inventory_table' %>
  </div>
</div>