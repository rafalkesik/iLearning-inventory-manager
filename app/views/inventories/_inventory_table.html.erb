<ul class="nav nav-tabs" id="myTab" role="tablist">
  <% @tabs.each.with_index do |tab, i| %>
    <%= nav_tab tab, active: i === 0 %>
  <% end %>
</ul>
<div class="tab-content p-2" id="myTabContent">
  <% @tabs.each.with_index do |tab, i| %>
    <%= nav_tab_content(tab, active: i === 0) %>
  <% end %>
</div>